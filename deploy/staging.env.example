# Staging config. Install at /etc/niko/staging.env, chmod 600, owned by niko.
#
# Note what is missing rather than what is here: BH_TOKEN and GEMINI_API_KEY
# are absent on purpose. Both integrations are gated on their key being
# present, so leaving them out is what stops staging polling bhfarm.net in
# lockstep with production and spending Gemini quota on test bills.

NODE_ENV=production
PORT=3001

# The `niko_staging` database in the same cluster. Same host, different
# database — check the name twice: this is the one line that decides whether
# staging is a sandbox or a second connection to the real books.
DATABASE_URL=postgres://doadmin:PASSWORD@db-postgresql-blr1-xxxxx.b.db.ondigitalocean.com:25060/niko_staging?sslmode=require

PGPOOL_MAX=5

# A *different* secret from production, so a staging session cookie is not
# accepted by the real app.
SESSION_SECRET=

# Used by scripts/refresh-staging.sh to reset every staging login after a
# rebuild. Production password hashes have no business on this box.
STAGING_PASSWORD=staging

# BH_TOKEN=        <- leave unset
# GEMINI_API_KEY=  <- leave unset
