# Production config. Install at /etc/niko/prod.env, chmod 600, owned by niko.
# Deliberately outside the checkout: a deploy pulls the repo and must never be
# able to overwrite this, and a missing file should stop the service rather
# than let it fall back to some other .env next to the code.

NODE_ENV=production
PORT=3000

# The managed cluster's `niko` database. Keep sslmode=require — the connection
# leaves the Droplet.
DATABASE_URL=postgres://doadmin:PASSWORD@db-postgresql-blr1-xxxxx.b.db.ondigitalocean.com:25060/niko?sslmode=require

# The smallest managed tier allows 22 backend connections in total, shared
# with staging and with any psql session. The driver defaults to 10 per
# instance, which leaves nothing spare.
PGPOOL_MAX=5

# openssl rand -hex 32. Changing it logs everyone out.
SESSION_SECRET=

# Big Herdsman IoT. Present here and absent from staging.env on purpose:
# without it the poller logs one line and stops, which is how staging is kept
# from polling the sheds alongside production.
BH_TOKEN=

# Gemini — bill OCR at the gate, and Dr niko.
GEMINI_API_KEY=
