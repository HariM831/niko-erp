# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/eggsy

# Signs session cookies. Any long random string; changing it logs everyone out.
SESSION_SECRET=

# Password given to the seeded admin account on first `npm run db:seed`.
SEED_ADMIN_PASSWORD=

# Google Gemini, for reading vendor bills at the gate (procurement extraction).
# Get one at https://aistudio.google.com/apikey — it is a metered key, so the
# OCR routes are behind auth and rate-limited before the model ever sees an image.
# Without it the gate still works: the bill photo is kept and the figures are
# typed by hand.
GEMINI_API_KEY=

# Zoho Books API — read-only migration pull. India data centre:
# accounts.zoho.in / www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORG_ID=
ZOHO_REFRESH_TOKEN=

# Big Herdsman IoT (bhfarm.net) — the controllers in the sheds.
# BH_TOKEN is the bearer token from bhfarm.net; raw JWT or "Bearer <jwt>" both
# work. It is long-lived (~180 days) — the current one expires 2026-11-11 and
# the poller warns as that approaches. Copy it from Amino's Replit secrets.
BH_TOKEN=
# The rest are optional; discovery fills them in.
#BH_TENANT=
#BH_FARM_ID=
#BH_TIMEZONE=+05:30
#BH_POLL_MS=300000
#IOT_HISTORY_RETENTION_DAYS=365
