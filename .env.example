# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/niko

# Signs session cookies. Any long random string; changing it logs everyone out.
SESSION_SECRET=

# Password given to the seeded admin account on first `npm run db:seed`.
SEED_ADMIN_PASSWORD=

# Google Gemini, for reading vendor bills at the gate (procurement extraction).
# Get one at https://aistudio.google.com/apikey — it is a metered key, so the
# OCR routes are behind auth and rate-limited before the model ever sees an image.
# Without it the gate still works: the bill photo is kept and the figures are
# typed by hand.
GEMINI_API_KEY=

# Zoho Books API — read-only migration pull. India data centre:
# accounts.zoho.in / www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORG_ID=
ZOHO_REFRESH_TOKEN=

# Big Herdsman IoT (bhfarm.net) — the controllers in the sheds.
# BH_TOKEN is the bearer token from bhfarm.net; raw JWT or "Bearer <jwt>" both
# work. It is long-lived (~180 days) — the current one expires 2026-11-11 and
# the poller warns as that approaches. Copy it from Amino's Replit secrets.
BH_TOKEN=
# The rest are optional; discovery fills them in.
#BH_TENANT=
#BH_FARM_ID=
#BH_TIMEZONE=+05:30
#BH_POLL_MS=300000
#IOT_HISTORY_RETENTION_DAYS=365

# Egg price forecast — TimesFM 2.5 on the benchmark series, drawn on the home
# page. Without these the tile is just the benchmark history it always was;
# nothing errors and no forecast appears.
#
# FORECAST_ENABLED belongs in production alone: prod and staging share one
# droplet and the model holds ~1.5 GB while it runs, so both loading it is the
# same hazard the deploy notes flag for the IoT poller running twice.
#   python3 -m venv /srv/niko/.venv-timesfm
#   /srv/niko/.venv-timesfm/bin/pip install torch --index-url https://download.pytorch.org/whl/cpu
#   /srv/niko/.venv-timesfm/bin/pip install "timesfm[torch]"
FORECAST_ENABLED=
FORECAST_PYTHON=/srv/niko/.venv-timesfm/bin/python

# The Indian festival calendar as an input to that forecast. Off: measured at
# 0.7% better over 180 origins — 0.16 paise an egg — which is inside the
# noise, and the effects it learns are faint because the benchmark series is
# already an average. Worth switching on and re-running the backtest the day
# the input becomes a raw NECC daily quote.
FORECAST_CALENDAR=
